  <office:drawing>
   <draw:page draw:name="Fig4" draw:master-page-name="Default">
    <draw:frame draw:name="fig4_y_axis_label" draw:style-name="G_fig4_y_axis_label" svg:x="15.000000mm" svg:y="1.000000mm" svg:width="100.000000mm" svg:height="4.300000mm">
     <draw:text-box>
      <text:p text:style-name="P_fig4_y_axis_label">
       <text:span text:style-name="T_fig4_y_axis_label">Share of strictly orderable pairs</text:span>
      </text:p>
