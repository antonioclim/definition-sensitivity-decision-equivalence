{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R13 normalised finite-state comparison input",
  "description": "A post-adapter contract, not proof that a source extraction or eligibility decision is correct.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "R13.1"
    },
    "dataset_kind": {
      "enum": [
        "TOY",
        "FAT",
        "OA"
      ]
    },
    "input_status": {
      "enum": [
        "synthetic_fixture",
        "real_extension_input"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_status": {
          "enum": [
            "synthetic_construction",
            "independently_reconciled"
          ]
        }
      },
      "required": [
        "source_label",
        "source_sha256",
        "adapter_status"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state_totals": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$|^-?[0-9]+/[1-9][0-9]*$"
            },
            "minProperties": 1
          },
          "known_denominator": {
            "type": "string",
            "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$|^-?[0-9]+/[1-9][0-9]*$"
          },
          "unresolved_total": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$|^-?[0-9]+/[1-9][0-9]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "unresolved_status": {
            "enum": [
              "known_nonnegative_total",
              "not_identifiable"
            ]
          }
        },
        "required": [
          "id",
          "state_totals",
          "known_denominator",
          "unresolved_total",
          "unresolved_status"
        ],
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "states"
        ],
        "additionalProperties": false
      }
    },
    "nested_boundaries": {
      "const": true
    },
    "objective": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "states"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "kind": {
                "const": "rank"
              },
              "direction": {
                "enum": [
                  "highest",
                  "lowest"
                ]
              },
              "k": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "kind",
              "direction",
              "k"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "kind": {
                "const": "threshold"
              },
              "operator": {
                "enum": [
                  "lt",
                  "le",
                  "gt",
                  "ge"
                ]
              },
              "threshold": {
                "type": "string",
                "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$|^-?[0-9]+/[1-9][0-9]*$"
              }
            },
            "required": [
              "id",
              "kind",
              "operator",
              "threshold"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "cost_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "false_positive": {
            "type": "string",
            "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$|^-?[0-9]+/[1-9][0-9]*$"
          },
          "false_negative": {
            "type": "string",
            "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$|^-?[0-9]+/[1-9][0-9]*$"
          }
        },
        "required": [
          "id",
          "false_positive",
          "false_negative"
        ],
        "additionalProperties": false
      }
    },
    "action_cost_profiles_by_rule": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "uniqueItems": true,
        "minItems": 1
      }
    },
    "mixture_weighting": {
      "const": "equal_eligible_units"
    },
    "primary_missing_policy": {
      "const": "complete_known_states"
    }
  },
  "required": [
    "schema_version",
    "dataset_kind",
    "input_status",
    "provenance",
    "states",
    "units",
    "boundaries",
    "nested_boundaries",
    "objective",
    "priority",
    "rules",
    "cost_profiles",
    "action_cost_profiles_by_rule",
    "mixture_weighting",
    "primary_missing_policy"
  ],
  "additionalProperties": false
}
